{
  "format": "nekophoto-brush-fixtures",
  "version": 1,
  "about": "Synthetic Procreate brushes (make_fixtures.py): the baseline and copies with one setting changed. Each is painted along `stroke` (a harness fixture) and compared with the baseline painted along the same stroke. `measure` is width (pixels across the stroke) or peak (the strongest alpha across it), at the stations where the input is high against those where it is low; `expect` is the direction of change against the baseline: up, down, turns (the width swings more as the tip turns), steady (it swings less: the tip turns with a curving stroke), continuous (no jump between neighbouring stations) or differs (the render is not the baseline's). These test the reader and the engine, not Procreate's own meaning: the iPad reference files decide that.",
  "baseline": "syn_00_baseline.brush",
  "brushes": {
    "syn_01_speed_size_pos.brush": {"setting": "dynamicsSpeedSize", "value": 0.8, "input": "speed", "target": "size", "stroke": "speed_sweep", "measure": "width", "expect": "up"},
    "syn_02_speed_size_neg.brush": {"setting": "dynamicsSpeedSize", "value": -0.8, "input": "speed", "target": "size", "stroke": "speed_sweep", "measure": "width", "expect": "down"},
    "syn_03_speed_opacity_pos.brush": {"setting": "dynamicsSpeedOpacity", "value": 0.8, "input": "speed", "target": "opacity", "stroke": "speed_sweep", "measure": "peak", "expect": "up"},
    "syn_04_speed_opacity_neg.brush": {"setting": "dynamicsSpeedOpacity", "value": -0.8, "input": "speed", "target": "opacity", "stroke": "speed_sweep", "measure": "peak", "expect": "down"},
    "syn_05_speed_spacing.brush": {"setting": "plotSpacingSpeed", "value": 1.0, "input": "speed", "target": "spacing", "stroke": "speed_sweep", "measure": "peak", "expect": "down"},
    "syn_06_tilt_size.brush": {"setting": "dynamicsTiltSize", "value": 0.8, "input": "tilt", "target": "size", "stroke": "tilt_sweep", "measure": "width", "expect": "up"},
    "syn_07_tilt_opacity.brush": {"setting": "dynamicsTiltOpacity", "value": 0.8, "input": "tilt", "target": "opacity", "stroke": "tilt_sweep", "measure": "peak", "expect": "down"},
    "syn_08_tilt_angle_30.brush": {"setting": "sizeTiltAngle", "value": 0.3333, "input": "tilt", "target": "size", "stroke": "tilt_sweep", "measure": "width", "expect": "up", "weakerThan": "syn_06_tilt_size.brush"},
    "syn_09_tilt_bleed.brush": {"setting": "dynamicsTiltBleed", "value": 0.8, "input": "tilt", "target": "flow", "stroke": "tilt_sweep", "measure": "peak", "expect": "down"},
    "syn_10_tilt_roundness.brush": {"setting": "dynamicsTiltShapeRoundness", "value": 1.0, "input": "tilt", "target": "roundness", "stroke": "tilt_sweep", "measure": "width", "expect": "down"},
    "syn_11_azimuth.brush": {"setting": "shapeAzimuth", "value": true, "input": "tiltDirection", "target": "angle", "stroke": "azimuth_sweep", "measure": "width", "expect": "turns"},
    "syn_12_roll.brush": {"setting": "shapeRoll", "value": true, "input": "roll", "target": "angle", "stroke": "twist_sweep", "measure": "width", "expect": "turns",
                          "also": [{"stroke": "twist_wrap", "measure": "width", "expect": "continuous"},
                                   {"stroke": "circle", "measure": "width", "expect": "steady"}]},
    "syn_13_grain_moving.brush": {"setting": "textureApplication", "value": 0, "input": "grain", "target": "stroke", "stroke": "straight_line", "measure": "render", "expect": "differs", "against": "syn_14_grain_texturized.brush"},
    "syn_14_grain_texturized.brush": {"setting": "textureApplication", "value": 1, "input": "grain", "target": "canvas", "stroke": "straight_line", "measure": "render", "expect": "differs"}
  }
}
