<?xml version="1.0" encoding="UTF-8"?>
<mime-info xmlns="http://www.freedesktop.org/standards/shared-mime-info">
  <mime-type type="application/x-compositor-project">
    <comment>Compositor project (.comp)</comment>
    <glob pattern="*.comp"/>
    <sub-class-of type="inode/directory"/>
  </mime-type>
  <!-- The shared MIME database knows .psd as Photoshop's type; the large-document variant is not listed there. -->
  <mime-type type="image/vnd.adobe.photoshop">
    <glob pattern="*.psb"/>
  </mime-type>
  <!-- Clip Studio Paint projects: no shared type exists; recognised by the CSFCHUNK signature, and by name. -->
  <mime-type type="application/x-clip-studio-project">
    <comment>Clip Studio Paint project</comment>
    <glob pattern="*.clip"/>
    <magic priority="60">
      <match type="string" offset="0" value="CSFCHUNK"/>
    </magic>
  </mime-type>
</mime-info>
