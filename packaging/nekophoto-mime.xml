<?xml version="1.0" encoding="UTF-8"?>
<mime-info xmlns="http://www.freedesktop.org/standards/shared-mime-info">
  <!-- A NekoPhoto document: one ZIP file whose first entry, "mimetype", is stored uncompressed (as in ODF and EPUB),
       so the type itself sits at byte 38, after the entry's name at byte 30. -->
  <mime-type type="application/vnd.nekophoto.document">
    <comment>NekoPhoto project</comment>
    <sub-class-of type="application/zip"/>
    <glob pattern="*.nekophoto"/>
    <magic priority="70">
      <match type="string" offset="30" value="mimetypeapplication/vnd.nekophoto.document"/>
    </magic>
  </mime-type>
  <!-- The project folder NekoPhoto saved before 1.8.7 (and Compositor for macOS); still opened and saved. -->
  <mime-type type="application/x-compositor-project">
    <comment>NekoPhoto project folder (.comp)</comment>
    <glob pattern="*.comp"/>
    <sub-class-of type="inode/directory"/>
  </mime-type>
  <!-- The shared MIME database knows .psd as Photoshop's type; the large-document variant is not listed there. -->
  <mime-type type="image/vnd.adobe.photoshop">
    <glob pattern="*.psb"/>
  </mime-type>
  <!-- Clip Studio Paint projects: no shared type exists; recognised by the CSFCHUNK signature, and by name. -->
  <mime-type type="application/x-clip-studio-project">
    <comment>Clip Studio Paint project</comment>
    <glob pattern="*.clip"/>
    <magic priority="60">
      <match type="string" offset="0" value="CSFCHUNK"/>
    </magic>
  </mime-type>
</mime-info>
