// The Windows resources of nekophoto.exe: icon, version information and the application manifest.
// Configured by src/app/CMakeLists.txt.
#include <winver.h>

IDI_ICON1 ICON "@COMPOSITOR_WIN_ICON@"
1 24 "@COMPOSITOR_WIN_MANIFEST@"

VS_VERSION_INFO VERSIONINFO
FILEVERSION @COMPOSITOR_WIN_VERSION_COMMAS@
PRODUCTVERSION @COMPOSITOR_WIN_VERSION_COMMAS@
FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
FILEFLAGS 0x0L
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "NekoPhoto contributors\0"
            VALUE "FileDescription", "NekoPhoto\0"
            VALUE "FileVersion", "@COMPOSITOR_VERSION_STRING@\0"
            VALUE "InternalName", "nekophoto\0"
            VALUE "LegalCopyright", "GPL-3.0-or-later; see LICENSE\0"
            VALUE "OriginalFilename", "nekophoto.exe\0"
            VALUE "ProductName", "NekoPhoto\0"
            VALUE "ProductVersion", "@COMPOSITOR_VERSION_STRING@\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
